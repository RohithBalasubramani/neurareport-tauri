# Tauri desktop build overrides.
# Used via: vite build --mode tauri
# Overrides .env.production values that are specific to webshell iframe embedding.

# Empty — initApiForTauri() discovers the backend URL via IPC at runtime
VITE_API_BASE_URL=
VITE_API_PORT=
VITE_USE_MOCK=false

# Empty — Tauri serves at root, not behind /neurareport proxy
VITE_ROUTER_BASENAME=
