{
  "identifier": "default",
  "description": "Default capabilities for NeuraReport desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:allow-exit",
    "process:allow-restart",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "http*://*" }
      ]
    }
  ]
}
